{
  "name": "aether-hospital-backend",
  "version": "1.0.0",
  "description": "Aether Hospital Backend API",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "seed": "node src/seed.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --testPathPatterns=src/tests --forceExit",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --testPathPatterns=src/tests --watch"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "cross-env": "^7.0.3",
    "jest": "^30.5.2",
    "nodemon": "^3.0.1",
    "supertest": "^7.3.0"
  }
}
